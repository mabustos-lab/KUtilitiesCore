<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>disable</ImplicitUsings>
		<Nullable>disable</Nullable>
		<LangVersion>latest</LangVersion>
		<Title>KUtilitiesCore.DataAccess.Http</Title>
		<Description>Implementación de acceso a datos mediante servicios API/HTTP.</Description>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackAsTool>False</PackAsTool>
		<IncludeSymbols>False</IncludeSymbols>
	</PropertyGroup>
	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>
	<ItemGroup>
		<!-- 1. Extensiones para HttpClientFactory (Inyección de dependencias robusta) -->
		<PackageReference Include="Microsoft.Extensions.Http" Version="10.0.12" />
		<!-- 2. Políticas de Resiliencia (Reintentos, Circuit Breaker) -->
		<PackageReference Include="Microsoft.Extensions.Http.Polly" Version="10.0.12" />
    <!-- 3. Utilidades Web (Para construir QueryStrings limpiamente sin System.Web) -->
    <PackageReference Include="Microsoft.AspNetCore.WebUtilities" Version="10.0.12" />
  </ItemGroup>
	<ItemGroup>
		<!-- Referencia al Core (Interfaces) -->
		<ProjectReference Include="..\KUtilitiesCore.DataAccess\KUtilitiesCore.DataAccess.csproj" />
	</ItemGroup>
</Project>
